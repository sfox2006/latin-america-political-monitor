# Optional email delivery. Reports are always written to output/ even when these are blank.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@example.com
EMAIL_TO=recipient@example.com

# Monitor settings
MONITOR_TIMEZONE=America/New_York
REQUEST_TIMEOUT=45
# GDELT asks API clients to make no more than one request every five seconds.
REQUEST_DELAY_SECONDS=5.25
MAX_RECORDS_PER_QUERY=250
SOURCE_BATCH_SIZE=8
ENRICH_HEADLINES=false
ENRICH_WORKERS=12
USER_AGENT=LatinAmericaPoliticalMonitor/1.0 (news-research; contact@example.com)
